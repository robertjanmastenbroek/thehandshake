# =============================================================================
# The Handshake — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:8000
ENVIRONMENT=development        # "development" | "staging" | "production"

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thehandshake

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# Generate a strong secret:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440  # 24 hours

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# https://dashboard.stripe.com/webhooks  (endpoint: /stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── AI / Agents ──────────────────────────────────────────────────────────────
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (optional)
GA_ID=

# ── Cron ────────────────────────────────────────────────────────────────────
# Secret used to authenticate cron-job endpoints (optional in dev)
CRON_SECRET=
